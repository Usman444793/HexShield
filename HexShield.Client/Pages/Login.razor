@page "/login"
@layout PublicLayout
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using HexShield.Shared.DTOs
@using HexShield.Shared.Enums
@inject HttpClient Http
@inject CustomAuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<PageTitle>Sign In | Hex Shield</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo"><i class="fa-solid fa-hexagon-nodes"></i></div>
            <h1>Welcome back</h1>
            <p>Sign in to your Hex Shield Workspace</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="auth-error">
                @errorMessage
            </div>
        }

        <EditForm Model="@loginRequest" OnValidSubmit="@HandleSubmit">
            <DataAnnotationsValidator />
            <div class="auth-form">
                <div class="form-group">
                    <label for="email">Email</label>
                    <InputText id="email" @bind-Value="loginRequest.Email" type="email" class="form-control" autocomplete="email" placeholder="name@company.com" />
                    <ValidationMessage For="@(() => loginRequest.Email)" />
                </div>
                <div class="form-group">
                    <label for="password">Password</label>
                    <InputText id="password" @bind-Value="loginRequest.Password" type="password" class="form-control" autocomplete="current-password" placeholder="••••••••" />
                    <ValidationMessage For="@(() => loginRequest.Password)" />
                </div>
                <button type="submit" class="auth-submit" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span>Signing In...</span>
                    }
                    else
                    {
                        <span>Sign In</span>
                    }
                </button>
            </div>
        </EditForm>

        <div class="auth-footer">
            Don't have an account?
            <a href="/register">Create One</a>
        </div>
    </div>
</div>

@code {
    private LoginRequestDto loginRequest = new();
    private bool isLoading;
    private string? errorMessage;

    private async Task HandleSubmit(EditContext context)
    {
        await LoginAsync();
    }

    private async Task LoginAsync()
    {
        errorMessage = null;
        isLoading = true;

        try
        {
            if (string.IsNullOrWhiteSpace(loginRequest.Email))
            {
                errorMessage = "Email is required.";
                return;
            }
            if (string.IsNullOrWhiteSpace(loginRequest.Password))
            {
                errorMessage = "Password is required.";
                return;
            }

            loginRequest.Email = loginRequest.Email.Trim();
            var response = await Http.PostAsJsonAsync("api/auth/login", loginRequest);
            var responseBody = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(responseBody);
                    if (doc.RootElement.TryGetProperty("detail", out var detailProp))
                    {
                        errorMessage = detailProp.GetString();
                    }
                    else if (doc.RootElement.TryGetProperty("message", out var msgProp))
                    {
                        errorMessage = msgProp.GetString();
                    }
                    else if (doc.RootElement.TryGetProperty("title", out var titleProp))
                    {
                        errorMessage = titleProp.GetString();
                    }
                    else
                    {
                        errorMessage = "Invalid email or password.";
                    }
                }
                catch
                {
                    errorMessage = string.IsNullOrWhiteSpace(responseBody)
                        ? "Authentication failed. Please verify your credentials."
                        : responseBody;
                }
                return;
            }

            var result = System.Text.Json.JsonSerializer.Deserialize<AuthResponseDto>(responseBody,
                new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

            if (result == null || string.IsNullOrWhiteSpace(result.AccessToken))
            {
                errorMessage = "Server returned an empty authentication token.";
                return;
            }

            await AuthState.MarkUserAsAuthenticated(result.AccessToken, result.RefreshToken);

            if (result.Roles?.Any(r => string.Equals(r, LmsRoles.Admin, StringComparison.OrdinalIgnoreCase)) == true)
            {
                Navigation.NavigateTo("/admin");
                return;
            }
            if (result.Roles?.Any(r => string.Equals(r, LmsRoles.Teacher, StringComparison.OrdinalIgnoreCase)) == true)
            {
                Navigation.NavigateTo("/teacher");
                return;
            }

            Navigation.NavigateTo("/student");
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to connect to service: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}