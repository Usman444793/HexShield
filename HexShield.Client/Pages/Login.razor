@page "/login"
@layout PublicLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject HttpClient Http
@inject CustomAuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JS
<PageTitle>Sign In | Hex Shield</PageTitle>
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo">H</div>
            <h1>Welcome back</h1>
            <p>
                Sign in to your Hex Shield Workspace
            </p>
        </div>
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="auth-error">
                @errorMessage
            </div>
        }
        <EditForm Model="@loginRequest" OnValidSubmit="@HandleSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="auth-form">
                <div class="form-group">
                    <label for="email">
                        Email
                    </label>
                    <InputText id="email" @bind-Value="loginRequest.Email" type="email" class="form-control" autocomplete="email" />
                    <ValidationMessage For="@(() => loginRequest.Email)" />
                </div>
                <div class="form-group">
                    <label for="password">Password </label>
                    <InputText id="password" @bind-Value="loginRequest.Password" type="password" class="form-control" autocomplete="current-password" />
                    <ValidationMessage For="@(() => loginRequest.Password)" />
                </div>
                <button type="submit"  class="auth-submit" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span>Signing In...</span>
                    }
                    else
                    {
                        <span>Sign In</span>
                    }
                </button>
            </div>
        </EditForm>
        <div class="auth-footer">
            Don't have an account?
            <a href="/register">
                Create One
            </a>
        </div>
    </div>
</div>
@code {
    private LoginRequestDto loginRequest = new();
    private bool isLoading;
    private string? errorMessage;
    private async Task HandleSubmit(EditContext context)
    {
        await LoginAsync();
    }
    private async Task LoginAsync()
    {
        errorMessage = null;
        isLoading = true;
        try
        {
            if (string.IsNullOrWhiteSpace(loginRequest.Email))
            {
                errorMessage = "Email is required.";
                return;
            }
            if (string.IsNullOrWhiteSpace(loginRequest.Password))
            {
                errorMessage = "Password is required.";
                return;
            }
            loginRequest.Email = loginRequest.Email.Trim();
            var response = await Http.PostAsJsonAsync( "api/auth/login", loginRequest);
            var responseBody = await response.Content.ReadAsStringAsync();
            Console.WriteLine( $"LOGIN STATUS: {response.StatusCode}");
            Console.WriteLine($"LOGIN RESPONSE: {responseBody}");
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"Login failed: {responseBody}";
                return;
            }
            var result = System.Text.Json.JsonSerializer.Deserialize<AuthResponseDto>(responseBody,
             new System.Text.Json.JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    });
            if (result == null)
            {
                errorMessage = "Authentication response was empty.";
                return;
            }
            if (string.IsNullOrWhiteSpace(result.AccessToken))
            {
                errorMessage = "Server returned no access token.";
                return;
            }
            await AuthState.MarkUserAsAuthenticated( result.AccessToken);
            if (result.Roles?.Any( r => string.Equals(r,"Admin",StringComparison.OrdinalIgnoreCase)) == true)
            {
                Navigation.NavigateTo( "/admin", forceLoad: true);
                return;
            }
            if (result.Roles?.Any(r => string.Equals(r,"Teacher",StringComparison.OrdinalIgnoreCase)) == true)
            {
                Navigation.NavigateTo("/teacher",forceLoad: true);
                return;
            }
            Navigation.NavigateTo( "/student", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine( $"LOGIN EXCEPTION: {ex}");
            errorMessage = $"Login failed: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
    private Task HandleInvalidSubmit(EditContext context)
    {
        errorMessage = "Please enter a valid email and password.";
        return Task.CompletedTask;
    }
}