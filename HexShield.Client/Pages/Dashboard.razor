@page "/admin"
@attribute [Authorize(Policy = "AdminOnly")]
@layout HexShield.Client.Components.Layout.AdminLayout

<PageTitle>Admin Command Center | HexShield</PageTitle>
<div class="admin-dashboard">
    <div class="page-heading">
        <div>
            <span class="eyebrow">
                HEXSHIELD ADMINISTRATION
            </span>
            <h1>Admin Command Center</h1>
            <p>
                Manage users, organizations, tenants, academic courses, access control, and security.
            </p>
        </div>
        <div class="system-status">
            <span></span>
            All core services operational
        </div>
    </div>
    <div class="admin-cards">
        <div class="admin-card">
            <span class="card-label">
                USER MANAGEMENT
            </span>
            <h2>Users</h2>
            <p>
                Create, update, activate and deactivate users across your tenant workspace.
            </p>
            <a href="/admin/users">
                Manage Users →
            </a>
        </div>
        <div class="admin-card">
            <span class="card-label">
                MULTI-TENANCY
            </span>
            <h2>Organizations</h2>
            <p>
                Manage institutional faculties, departments, programs, and hierarchy boundaries.
            </p>
            <a href="/admin/organizations">
                Manage Organizations →
            </a>
        </div>
        <div class="admin-card">
            <span class="card-label">
                ISOLATION
            </span>
            <h2>Tenants</h2>
            <p>
                Manage multi-tenant customers, custom domain routing, and isolated workspaces.
            </p>
            <a href="/admin/tenants">
                Manage Tenants →
            </a>
        </div>
        <div class="admin-card">
            <span class="card-label">
                CURRICULUM
            </span>
            <h2>Courses</h2>
            <p>
                Provision courses, publish curriculum modules, and oversee assignments and quizzes.
            </p>
            <a href="/admin/courses">
                Manage Courses →
            </a>
        </div>
        <div class="admin-card">
            <span class="card-label">
                RBAC
            </span>
            <h2>Access Control</h2>
            <p>
                Assign and remove application roles and fine-grained permissions for users.
            </p>
            <a href="/admin/access-control">
                Manage Access →
            </a>
        </div>
        <div class="admin-card">
            <span class="card-label">
                SECURITY
            </span>
            <h2>Security Center</h2>
            <p>
                Inspect JWT telemetry, test refresh token rotation, and verify security shields.
            </p>
            <a href="/admin/security">
                Security Center →
            </a>
        </div>
    </div>
</div>
