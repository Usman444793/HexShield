@page "/admin/security"
@layout AdminLayout
@attribute [Authorize(Policy = "AdminOnly")]
@using System.IdentityModel.Tokens.Jwt
@using HexShield.Client.Services
@inject CustomAuthenticationStateProvider AuthState

<PageTitle>Security Command Center | HexShield</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="text-muted small mb-1">
                <a href="/admin" class="text-decoration-none text-muted"><i class="fa-solid fa-arrow-left"></i> Dashboard</a>
            </div>
            <h2 class="fw-bold mb-1">Security &amp; Infrastructure Center</h2>
            <p class="text-muted mb-0">Overview of multi-tenant cryptographic isolation, authentication policies, refresh token rotation, and API rate limiting.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-primary" @onclick="RotateTokenManualAsync" disabled="@isRotating">
                <i class="fa-solid @(isRotating ? "fa-spinner fa-spin" : "fa-arrows-rotate") me-1"></i>
                @(isRotating ? "Rotating Token..." : "Rotate Refresh Token Now")
            </button>
            <span class="badge bg-success px-3 py-2 fs-6">
                <i class="fa-solid fa-circle-check me-1"></i> All Shields Active
            </span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(rotationMessage))
    {
        <div class="alert @(rotationError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-4" role="alert">
            <i class="fa-solid @(rotationError ? "fa-triangle-exclamation" : "fa-shield-check") me-2"></i>
            <span>@rotationMessage</span>
            <button type="button" class="btn-close" @onclick="() => rotationMessage = null"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0"><i class="fa-solid fa-fingerprint text-primary me-2"></i>Active Session &amp; Refresh Token Telemetry</h5>
            <span class="badge @(hasRefreshToken ? "bg-success" : "bg-warning text-dark")">
                @(hasRefreshToken ? "Refresh Token Active (SHA-256 Hashed)" : "No Refresh Token Found")
            </span>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <div class="text-muted small fw-semibold">TOKEN JTI (UNIQUE ID)</div>
                        <div class="fw-bold text-dark mt-1 text-truncate" title="@currentJti"><code>@(string.IsNullOrEmpty(currentJti) ? "N/A" : currentJti)</code></div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <div class="text-muted small fw-semibold">ACCESS TOKEN EXPIRES (UTC)</div>
                        <div class="fw-bold text-dark mt-1">@(tokenExpiresUtc?.ToString("yyyy-MM-dd HH:mm:ss 'UTC'") ?? "N/A")</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <div class="text-muted small fw-semibold">REFRESH TOKEN FINGERPRINT</div>
                        <div class="fw-bold text-dark mt-1"><code>@refreshTokenPreview</code></div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <div class="text-muted small fw-semibold">ROTATION &amp; REPLAY PROTECTION</div>
                        <div class="fw-bold text-success mt-1"><i class="fa-solid fa-lock me-1"></i>One-Time Use Enforced</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-3 p-3 text-white me-3" style="background: #0b3948;">
                            <i class="fa-solid fa-key fa-xl"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Identity &amp; JWT</h5>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">ENFORCED</span>
                        </div>
                    </div>
                    <ul class="list-unstyled mb-0 small text-muted">
                        <li class="py-1"><strong>Algorithm:</strong> HMAC-SHA256 (256-bit Key)</li>
                        <li class="py-1"><strong>Clock Skew:</strong> 30 seconds</li>
                        <li class="py-1"><strong>Refresh Policy:</strong> Anti-replay token rotation</li>
                        <li class="py-1"><strong>Lockout:</strong> 5 failed attempts &rarr; 15m lockout</li>
                        <li class="py-1"><strong>Password Policy:</strong> &ge; 12 chars (Upper, Lower, Digit, Special)</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-3 p-3 text-white me-3" style="background: #0b3948;">
                            <i class="fa-solid fa-layer-group fa-xl"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Multi-Tenancy</h5>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">ISOLATED</span>
                        </div>
                    </div>
                    <ul class="list-unstyled mb-0 small text-muted">
                        <li class="py-1"><strong>Filter:</strong> EF Core Global Query Filter on all tables</li>
                        <li class="py-1"><strong>Resolution:</strong> Claims &rarr; Headers &rarr; Subdomain &rarr; Default</li>
                        <li class="py-1"><strong>Soft Delete:</strong> <code>IsDeleted = 0</code> automatic exclusion</li>
                        <li class="py-1"><strong>Cross-Tenant Leakage:</strong> Zero-tolerance query filter</li>
                        <li class="py-1"><strong>Audit Trail:</strong> CreatedAt, CreatedBy, UpdatedAt tracked</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-3 p-3 text-white me-3" style="background: #0b3948;">
                            <i class="fa-solid fa-gauge-high fa-xl"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">API Rate Limiting</h5>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">ACTIVE</span>
                        </div>
                    </div>
                    <ul class="list-unstyled mb-0 small text-muted">
                        <li class="py-1"><strong>General API:</strong> 100 requests / minute per IP</li>
                        <li class="py-1"><strong>Auth Endpoints:</strong> 10 requests / minute (anti-bruteforce)</li>
                        <li class="py-1"><strong>Status Code:</strong> HTTP 429 Too Many Requests</li>
                        <li class="py-1"><strong>Concurrency:</strong> RowVersion optimistic concurrency check</li>
                        <li class="py-1"><strong>Exception Handling:</strong> RFC-7807 ProblemDetails format</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="fw-bold mb-0">Enterprise Security Checklist</h5>
        </div>
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Security Control</th>
                            <th>Target Standard</th>
                            <th>Implementation Mechanism</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="fw-semibold">Multi-Tenant Data Partitioning</td>
                            <td>Zero Cross-Tenant Leakage</td>
                            <td>EF Core Global Query Filters + TenantResolverMiddleware</td>
                            <td><span class="badge bg-success"><i class="fa-solid fa-check me-1"></i> Verified</span></td>
                        </tr>
                        <tr>
                            <td class="fw-semibold">Refresh Token Rotation &amp; Replay Detection</td>
                            <td>OAuth 2.0 Security BCP</td>
                            <td>SHA-256 Token Hashing + One-Time Rotation + Family Revocation</td>
                            <td><span class="badge bg-success"><i class="fa-solid fa-check me-1"></i> Verified</span></td>
                        </tr>
                        <tr>
                            <td class="fw-semibold">Optimistic Concurrency Protection</td>
                            <td>Prevent Lost Updates</td>
                            <td>SQL Server <code>rowversion</code> + EF ConcurrencyToken</td>
                            <td><span class="badge bg-success"><i class="fa-solid fa-check me-1"></i> Verified</span></td>
                        </tr>
                        <tr>
                            <td class="fw-semibold">Role-Based Access Control (RBAC)</td>
                            <td>Least Privilege Principle</td>
                            <td>ClaimsPrincipal + Custom Auth Policies (Admin, Teacher, Student)</td>
                            <td><span class="badge bg-success"><i class="fa-solid fa-check me-1"></i> Verified</span></td>
                        </tr>
                        <tr>
                            <td class="fw-semibold">Brute-Force &amp; Credential Stuffing Defense</td>
                            <td>OWASP Authentication Top 10</td>
                            <td>Identity Lockout (5 attempts) + Auth FixedWindow RateLimiter (10/min)</td>
                            <td><span class="badge bg-success"><i class="fa-solid fa-check me-1"></i> Verified</span></td>
                        </tr>
                        <tr>
                            <td class="fw-semibold">Data Protection Key Persistence</td>
                            <td>Stateless Cluster Safe</td>
                            <td>Entity Framework Core Key Repository (DataProtectionKeys table)</td>
                            <td><span class="badge bg-success"><i class="fa-solid fa-check me-1"></i> Verified</span></td>
                        </tr>
                        <tr>
                            <td class="fw-semibold">Automated Soft-Delete Audit Trail</td>
                            <td>Regulatory Audit Compliance</td>
                            <td>BaseEntity interceptor with CreatedAt/Updated/Deleted audit timestamps</td>
                            <td><span class="badge bg-success"><i class="fa-solid fa-check me-1"></i> Verified</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private string? currentJti;
    private DateTime? tokenExpiresUtc;
    private string refreshTokenPreview = "Not available";
    private bool hasRefreshToken;
    private bool isRotating;
    private string? rotationMessage;
    private bool rotationError;

    protected override async Task OnInitializedAsync()
    {
        await LoadTokenTelemetryAsync();
    }

    private async Task LoadTokenTelemetryAsync()
    {
        try
        {
            var accessToken = await AuthState.GetAccessTokenAsync();
            var refreshToken = await AuthState.GetRefreshTokenAsync();

            hasRefreshToken = !string.IsNullOrWhiteSpace(refreshToken);
            if (hasRefreshToken && refreshToken!.Length >= 12)
            {
                refreshTokenPreview = $"{refreshToken[..8]}••••{refreshToken[^4..]}";
            }
            else if (hasRefreshToken)
            {
                refreshTokenPreview = "Active";
            }
            else
            {
                refreshTokenPreview = "None";
            }

            if (!string.IsNullOrWhiteSpace(accessToken))
            {
                var jwt = new JwtSecurityTokenHandler().ReadJwtToken(accessToken);
                currentJti = jwt.Id;
                tokenExpiresUtc = jwt.ValidTo;
            }
        }
        catch
        {
        }
    }

    private async Task RotateTokenManualAsync()
    {
        isRotating = true;
        rotationMessage = null;
        try
        {
            var newToken = await AuthState.TryRefreshTokenAsync(forceRefresh: true);
            if (!string.IsNullOrWhiteSpace(newToken))
            {
                await LoadTokenTelemetryAsync();
                rotationError = false;
                rotationMessage = $"Refresh token rotated successfully! New JWT JTI: {currentJti} (Valid until {tokenExpiresUtc:HH:mm:ss} UTC).";
            }
            else
            {
                rotationError = true;
                rotationMessage = "Failed to rotate refresh token. Please sign in again to issue a fresh token pair.";
            }
        }
        catch (Exception ex)
        {
            rotationError = true;
            rotationMessage = $"Refresh token rotation error: {ex.Message}";
        }
        finally
        {
            isRotating = false;
        }
    }
}
