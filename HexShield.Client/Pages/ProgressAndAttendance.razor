@page "/teacher/courses/{CourseId:int}/attendance"
@page "/admin/courses/{CourseId:int}/attendance"
@attribute [Authorize(Roles = "Admin,Teacher")]
@layout AdminLayout
@using System.Net.Http.Json
@using HexShield.Shared.DTOs
@using HexShield.Shared.Enums
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Attendance &amp; Progress Management | HexShield</PageTitle>

<div class="analytics-container">
    <div class="course-subnav">
        <a href="/@BasePortalSegment/courses" class="back-link">← All Courses</a>
        <div class="subnav-tabs">
            <a href="/@BasePortalSegment/courses/@CourseId/lessons" class="subnav-tab"><i class="fa-solid fa-chalkboard"></i> Lessons</a>
            <a href="/@BasePortalSegment/courses/@CourseId/assignments" class="subnav-tab"><i class="fa-solid fa-clipboard"></i> Assignments</a>
            <a href="/@BasePortalSegment/courses/@CourseId/quizzes" class="subnav-tab"><i class="fa-solid fa-stopwatch"></i> Quizzes</a>
            <a href="/@BasePortalSegment/courses/@CourseId/enrollments" class="subnav-tab"><i class="fa-solid fa-users"></i> Enrollments</a>
            <a href="/@BasePortalSegment/courses/@CourseId/attendance" class="subnav-tab active"><i class="fa-solid fa-chart-bar"></i> Attendance &amp; Progress</a>
        </div>
    </div>

    <div class="page-header">
        <div>
            <h1 class="page-title">Course #@CourseId — Attendance &amp; Progress Management</h1>
            <p class="page-subtitle">Record daily session attendance and monitor lesson &amp; assignment completion across enrolled students.</p>
        </div>
        <div class="header-actions">
            <button type="button" class="btn-secondary" @onclick="MarkAllPresent" disabled="@(!studentRows.Any() || isSaving)">
                ✓ Mark All Present
            </button>
            <button type="button" class="btn-primary" @onclick="SaveAttendance" disabled="@(!studentRows.Any() || isSaving)">
                <i class="fa-solid fa-floppy-disk"></i> @(isSaving ? "Saving Roll Call..." : "Save Attendance")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success")">
            <span>@statusMessage</span>
            <button type="button" class="alert-close" @onclick="() => statusMessage = null">&times;</button>
        </div>
    }

    <!-- Summary KPI Row -->
    <div class="summary-kpi-grid">
        <div class="summary-kpi-card">
            <span>ENROLLED STUDENTS</span>
            <strong>@studentRows.Count</strong>
        </div>
        <div class="summary-kpi-card">
            <span>AVG LESSON COMPLETION</span>
            <strong>@(studentRows.Any() ? Math.Round(studentRows.Average(s => s.CompletionPercentage), 1) : 0)%</strong>
        </div>
        <div class="summary-kpi-card">
            <span>AVG ATTENDANCE RATE</span>
            <strong>@(studentRows.Any() ? Math.Round(studentRows.Average(s => s.AttendancePercentage), 1) : 100)%</strong>
        </div>
        <div class="summary-kpi-card">
            <span>SESSION DATE</span>
            <strong>@selectedDate.ToString("MMM dd, yyyy")</strong>
        </div>
    </div>

    <div class="filter-bar">
        <div class="form-group inline">
            <label>Roll Call Session Date:</label>
            <input type="date" class="form-control" @bind="selectedDate" @bind:after="LoadRosterAndProgress" />
        </div>
        <span class="filter-hint">Select any date to view or update attendance records for that session.</span>
    </div>

    <div class="table-card">
        @if (isLoading)
        {
            <div class="loading-state">
                <i class="fa-solid fa-spinner fa-spin spinner"></i>
                <p>Loading student progress &amp; attendance roster...</p>
            </div>
        }
        else if (!studentRows.Any())
        {
            <div class="empty-state">
                <h3>No active students enrolled in this course</h3>
                <p>Enroll students in the Enrollments tab to begin tracking their attendance and lesson progress.</p>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Student Name</th>
                            <th>Lesson Completion Progress</th>
                            <th>Assignments Submitted</th>
                            <th>Overall Attendance Rate</th>
                            <th>Session Status (@selectedDate.ToString("yyyy-MM-dd"))</th>
                            <th>Session Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in studentRows)
                        {
                            <tr>
                                <td>
                                    <strong>@student.StudentName</strong>
                                    <div class="student-id-sub">@student.StudentId</div>
                                </td>
                                <td>
                                    <div class="progress-bar-container">
                                        <div class="progress-bar" style="width: @(student.CompletionPercentage)%"></div>
                                    </div>
                                    <small>@student.CompletedLessons / @student.TotalLessons lessons (@student.CompletionPercentage%)</small>
                                </td>
                                <td>
                                    <span class="badge-neutral">@student.SubmittedAssignments / @student.TotalAssignments</span>
                                </td>
                                <td>
                                    <strong class="rate-badge @(student.AttendancePercentage >= 75 ? "good" : "warn")">
                                        @student.AttendancePercentage%
                                    </strong>
                                </td>
                                <td>
                                    <select class="form-control select-compact" @bind="student.CurrentAttendanceStatus">
                                        <option value="@AttendanceStatus.Present">Present</option>
                                        <option value="@AttendanceStatus.Late">Late</option>
                                        <option value="@AttendanceStatus.Absent">Absent</option>
                                        <option value="@AttendanceStatus.Excused">Excused</option>
                                    </select>
                                </td>
                                <td>
                                    <input type="text" class="form-control remarks-input"
                                           placeholder="Optional note..."
                                           @bind="student.CurrentRemarks" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int CourseId { get; set; }

    private DateTime selectedDate = DateTime.Today;
    private List<StudentRowVm> studentRows = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private string? statusMessage;
    private bool isError;

    private string BasePortalSegment =>
        Navigation.Uri.Contains("/teacher", StringComparison.OrdinalIgnoreCase) ? "teacher" : "admin";

    public record StudentRowVm : StudentCourseProgressDto
    {
        public AttendanceStatus CurrentAttendanceStatus { get; set; } = AttendanceStatus.Present;
        public string? CurrentRemarks { get; set; }

        public StudentRowVm(StudentCourseProgressDto baseDto)
            : base(baseDto.StudentId, baseDto.StudentName, baseDto.TotalLessons, baseDto.CompletedLessons,
                   baseDto.CompletionPercentage, baseDto.TotalAssignments, baseDto.SubmittedAssignments,
                   baseDto.AttendancePercentage)
        {
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadRosterAndProgress();
    }

    private async Task LoadRosterAndProgress()
    {
        isLoading = true;
        try
        {
            var progressData = await Http.GetFromJsonAsync<List<StudentCourseProgressDto>>($"api/analytics/progress/course/{CourseId}") ?? new();
            var attendanceData = await Http.GetFromJsonAsync<List<AttendanceRecordDto>>($"api/analytics/attendance/course/{CourseId}?date={selectedDate:yyyy-MM-dd}") ?? new();

            studentRows = progressData.Select(p =>
            {
                var vm = new StudentRowVm(p);
                var existingAtt = attendanceData.FirstOrDefault(a => a.StudentId == p.StudentId);
                if (existingAtt != null)
                {
                    vm.CurrentAttendanceStatus = existingAtt.Status;
                    vm.CurrentRemarks = existingAtt.Remarks;
                }
                return vm;
            }).ToList();
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void MarkAllPresent()
    {
        foreach (var row in studentRows)
        {
            row.CurrentAttendanceStatus = AttendanceStatus.Present;
        }
        statusMessage = "All students marked Present for this session. Click 'Save Attendance' to persist.";
        isError = false;
    }

    private async Task SaveAttendance()
    {
        isSaving = true;
        try
        {
            var payload = new BulkMarkAttendanceRequestDto(
                CourseId,
                null,
                selectedDate,
                studentRows.Select(s => new StudentAttendanceItemDto(s.StudentId, s.CurrentAttendanceStatus, s.CurrentRemarks)).ToList()
            );

            var response = await Http.PostAsJsonAsync("api/analytics/attendance/bulk", payload);
            if (response.IsSuccessStatusCode)
            {
                statusMessage = $"Attendance for {selectedDate:yyyy-MM-dd} saved successfully!";
                isError = false;
                await LoadRosterAndProgress();
            }
            else
            {
                statusMessage = "Failed to save attendance.";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            isError = true;
        }
        finally
        {
            isSaving = false;
        }
    }
}
