@page "/admin/courses/{CourseId:int}/assignments"
@page "/teacher/courses/{CourseId:int}/assignments"
@attribute [Authorize(Roles = "Admin,Teacher")]
@layout AdminLayout
@using System.Net.Http.Json
@using HexShield.Shared.DTOs
@using HexShield.Shared.Enums
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Assignments &amp; Grading | HexShield</PageTitle>

<div class="assignments-container">
    <div class="course-subnav">
        <a href="/@BasePortalSegment/courses" class="back-link">← All Courses</a>
        <div class="subnav-tabs">
            <a href="/@BasePortalSegment/courses/@CourseId/lessons" class="subnav-tab"><i class="fa-solid fa-chalkboard"></i> Lessons</a>
            <a href="/@BasePortalSegment/courses/@CourseId/assignments" class="subnav-tab active"><i class="fa-solid fa-clipboard"></i> Assignments</a>
            <a href="/@BasePortalSegment/courses/@CourseId/quizzes" class="subnav-tab"><i class="fa-solid fa-stopwatch"></i> Quizzes</a>
            <a href="/@BasePortalSegment/courses/@CourseId/enrollments" class="subnav-tab"><i class="fa-solid fa-users"></i> Enrollments</a>
            <a href="/@BasePortalSegment/courses/@CourseId/attendance" class="subnav-tab"><i class="fa-solid fa-chart-bar"></i> Attendance &amp; Progress</a>
        </div>
    </div>

    <div class="page-header">
        <div>
            <h1 class="page-title">Course #@CourseId — Assignments &amp; Grading</h1>
            <p class="page-subtitle">Create coursework, review student submissions, and record grades &amp; feedback.</p>
        </div>
        <button type="button" class="btn-primary" @onclick="OpenCreateModal">
            <i class="fa-solid fa-plus"></i> Add Assignment
        </button>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success")">
            <span>@statusMessage</span>
            <button type="button" class="alert-close" @onclick="() => statusMessage = null">&times;</button>
        </div>
    }

    <div class="table-card">
        @if (isLoading)
        {
            <div class="loading-state">
                <i class="fa-solid fa-spinner fa-spin spinner"></i>
                <p>Loading assignments...</p>
            </div>
        }
        else if (!assignments.Any())
        {
            <div class="empty-state">
                <h3>No assignments created for this course yet</h3>
                <p>Click "Add Assignment" to publish coursework for enrolled students.</p>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Assignment Title</th>
                            <th>Due Date</th>
                            <th>Max Score</th>
                            <th>Submissions</th>
                            <th>Status</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in assignments)
                        {
                            <tr>
                                <td><strong>@item.Title</strong></td>
                                <td>@item.DueDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><span class="badge-neutral">@item.MaxScore pts</span></td>
                                <td>
                                    <span class="badge-neutral">@item.SubmissionCount Submitted</span>
                                </td>
                                <td>
                                    <span class="badge @(item.IsPublished ? "status-published" : "status-draft")">
                                        @(item.IsPublished ? "● Published" : "○ Draft")
                                    </span>
                                </td>
                                <td class="text-right">
                                    <div class="action-buttons">
                                        <button type="button" class="btn-subaction" @onclick="() => ViewSubmissions(item)">
                                            📋 Submissions &amp; Grade (@item.SubmissionCount)
                                        </button>
                                        <button type="button" class="btn-icon btn-danger-icon" title="Delete" @onclick="() => DeleteAssignment(item.Id)">
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Create Assignment Centered Modal -->
@if (isDrawerOpen)
{
    <div class="modal-overlay" @onclick="() => isDrawerOpen = false">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Create New Assignment</h2>
                <button type="button" class="modal-close" @onclick="() => isDrawerOpen = false">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Assignment Title *</label>
                    <input type="text" class="form-control" @bind="newTitle" placeholder="e.g. Midterm Architecture Report" />
                </div>
                <div class="form-row-2">
                    <div class="form-group">
                        <label>Due Date *</label>
                        <input type="datetime-local" class="form-control" @bind="newDueDate" />
                    </div>
                    <div class="form-group">
                        <label>Max Score (Points) *</label>
                        <input type="number" class="form-control" @bind="newMaxScore" min="1" max="1000" />
                    </div>
                </div>
                <div class="form-group">
                    <label>Instructions &amp; Rubric</label>
                    <textarea class="form-control textarea" rows="5" @bind="newDescription" placeholder="Provide detailed submission instructions and grading criteria..."></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" @onclick="() => isDrawerOpen = false">Cancel</button>
                    <button type="button" class="btn-primary" @onclick="CreateAssignment">Create Assignment</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- View & Grade Submissions Centered Modal -->
@if (isSubmissionsModalOpen && selectedAssignment != null)
{
    <div class="modal-overlay" @onclick="CloseSubmissionsModal">
        <div class="modal-card modal-card-xl" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <h2>Submissions — @selectedAssignment.Title</h2>
                    <span class="modal-subtitle">Max Score: @selectedAssignment.MaxScore pts · Due: @selectedAssignment.DueDate.ToString("yyyy-MM-dd HH:mm")</span>
                </div>
                <button type="button" class="modal-close" @onclick="CloseSubmissionsModal">&times;</button>
            </div>
            <div class="modal-body">
                @if (isSubmissionsLoading)
                {
                    <div class="loading-state">
                        <p>Loading student submissions...</p>
                    </div>
                }
                else if (!submissions.Any())
                {
                    <div class="empty-state">
                        <h3>No student submissions yet</h3>
                        <p>Once enrolled students submit their work, their answers and attachments will appear here for grading.</p>
                    </div>
                }
                else
                {
                    <div class="submissions-list">
                        @foreach (var sub in submissions)
                        {
                            <div class="submission-card">
                                <div class="submission-header">
                                    <div>
                                        <strong>@sub.StudentName</strong>
                                        <span class="sub-date">Submitted @sub.SubmittedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                    </div>
                                    <span class="badge @(sub.Status == SubmissionStatus.Graded ? "status-published" : "status-draft")">
                                        @sub.Status @(sub.Grade.HasValue ? $"({sub.Grade}/{selectedAssignment.MaxScore})" : "")
                                    </span>
                                </div>

                                <div class="submission-content-box">
                                    <label>Student Response:</label>
                                    <p>@(string.IsNullOrWhiteSpace(sub.Content) ? "No text content provided." : sub.Content)</p>
                                    @if (!string.IsNullOrWhiteSpace(sub.AttachmentUrl))
                                    {
                                        <a href="@sub.AttachmentUrl" target="_blank" class="attachment-link">🔗 View Attachment (@sub.AttachmentUrl)</a>
                                    }
                                </div>

                                <div class="grading-row">
                                    <div class="grade-input-group">
                                        <label>Score (0 - @selectedAssignment.MaxScore)</label>
                                        <input type="number" class="form-control" min="0" max="@selectedAssignment.MaxScore" step="0.5"
                                               @bind="sub.EditGrade" />
                                    </div>
                                    <div class="feedback-input-group">
                                        <label>Instructor Feedback</label>
                                        <input type="text" class="form-control" placeholder="Constructive feedback for student..."
                                               @bind="sub.EditFeedback" />
                                    </div>
                                    <button type="button" class="btn-primary grade-save-btn"
                                            disabled="@sub.IsGrading"
                                            @onclick="() => SaveGrade(sub)">
                                        @(sub.IsGrading ? "Saving..." : "Save Grade")
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int CourseId { get; set; }

    private List<AssignmentListDto> assignments = new();
    private bool isLoading = true;
    private bool isDrawerOpen = false;

    private string newTitle = string.Empty;
    private string? newDescription;
    private DateTime newDueDate = DateTime.UtcNow.AddDays(7);
    private decimal newMaxScore = 100;

    private bool isSubmissionsModalOpen = false;
    private bool isSubmissionsLoading = false;
    private AssignmentListDto? selectedAssignment;
    private List<SubmissionRowVm> submissions = new();

    private string? statusMessage;
    private bool isError;

    private string BasePortalSegment =>
        Navigation.Uri.Contains("/teacher", StringComparison.OrdinalIgnoreCase) ? "teacher" : "admin";

    public class SubmissionRowVm
    {
        public int Id { get; set; }
        public int AssignmentId { get; set; }
        public string StudentId { get; set; } = string.Empty;
        public string StudentName { get; set; } = string.Empty;
        public string? Content { get; set; }
        public string? AttachmentUrl { get; set; }
        public DateTime SubmittedAt { get; set; }
        public decimal? Grade { get; set; }
        public string? Feedback { get; set; }
        public SubmissionStatus Status { get; set; }
        public decimal EditGrade { get; set; }
        public string? EditFeedback { get; set; }
        public bool IsGrading { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAssignments();
    }

    private async Task LoadAssignments()
    {
        isLoading = true;
        try
        {
            assignments = await Http.GetFromJsonAsync<List<AssignmentListDto>>($"api/assignments/course/{CourseId}") ?? new();
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        newTitle = string.Empty;
        newDescription = null;
        newDueDate = DateTime.UtcNow.AddDays(7);
        newMaxScore = 100;
        isDrawerOpen = true;
    }

    private async Task CreateAssignment()
    {
        if (string.IsNullOrWhiteSpace(newTitle))
        {
            statusMessage = "Please provide an assignment title.";
            isError = true;
            return;
        }

        try
        {
            var dto = new CreateAssignmentRequestDto(CourseId, null, newTitle.Trim(), newDescription?.Trim(), newDueDate, newMaxScore);
            var response = await Http.PostAsJsonAsync("api/assignments", dto);
            if (response.IsSuccessStatusCode)
            {
                isDrawerOpen = false;
                statusMessage = "Assignment created and published successfully.";
                isError = false;
                await LoadAssignments();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                statusMessage = $"Failed to create assignment: {err}";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isError = true;
        }
    }

    private async Task DeleteAssignment(int id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/assignments/{id}");
            if (response.IsSuccessStatusCode)
            {
                statusMessage = "Assignment deleted.";
                isError = false;
                await LoadAssignments();
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isError = true;
        }
    }

    private async Task ViewSubmissions(AssignmentListDto assignment)
    {
        selectedAssignment = assignment;
        isSubmissionsModalOpen = true;
        isSubmissionsLoading = true;
        submissions.Clear();
        try
        {
            var list = await Http.GetFromJsonAsync<List<SubmissionListDto>>($"api/assignments/{assignment.Id}/submissions") ?? new();
            submissions = list.Select(s => new SubmissionRowVm
            {
                Id = s.Id,
                AssignmentId = s.AssignmentId,
                StudentId = s.StudentId,
                StudentName = s.StudentName,
                Content = s.Content,
                AttachmentUrl = s.AttachmentUrl,
                SubmittedAt = s.SubmittedAt,
                Grade = s.Status == SubmissionStatus.Graded ? s.Grade : null,
                Feedback = s.Feedback,
                Status = s.Status,
                EditGrade = s.Status == SubmissionStatus.Graded ? s.Grade : assignment.MaxScore,
                EditFeedback = s.Feedback
            }).ToList();
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to load submissions: {ex.Message}";
            isError = true;
        }
        finally
        {
            isSubmissionsLoading = false;
        }
    }

    private async Task SaveGrade(SubmissionRowVm sub)
    {
        if (selectedAssignment == null) return;
        sub.IsGrading = true;
        try
        {
            var dto = new GradeSubmissionRequestDto(sub.EditGrade, sub.EditFeedback);
            var response = await Http.PostAsJsonAsync($"api/assignments/submissions/{sub.Id}/grades", dto);
            if (response.IsSuccessStatusCode)
            {
                var updated = await response.Content.ReadFromJsonAsync<SubmissionListDto>();
                if (updated != null)
                {
                    sub.Grade = updated.Grade;
                    sub.Feedback = updated.Feedback;
                    sub.Status = updated.Status;
                }
                statusMessage = $"Graded submission for {sub.StudentName} ({sub.EditGrade}/{selectedAssignment.MaxScore}).";
                isError = false;
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                statusMessage = $"Grading failed: {err}";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Grading error: {ex.Message}";
            isError = true;
        }
        finally
        {
            sub.IsGrading = false;
        }
    }

    private void CloseSubmissionsModal()
    {
        isSubmissionsModalOpen = false;
        selectedAssignment = null;
    }
}