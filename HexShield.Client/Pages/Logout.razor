@page "/logout"
@using HexShield.Client.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@layout PublicLayout

<PageTitle>Signing out | HexShield</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Signing out</h1>
            <p>Clearing your HexShield session.</p>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var markOut = AuthStateProvider?.GetType().GetMethod("MarkUserAsLoggedOut");
        if (markOut != null)
        {
            var task = markOut.Invoke(AuthStateProvider, null);
            if (task is Task t) await t;
        }
        Navigation.NavigateTo("/login");
    }
}
