@page "/logout"
@layout PublicLayout
@using HexShield.Client.Services
@inject CustomAuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<PageTitle>Signing out | HexShield</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo"><i class="fa-solid fa-hexagon-nodes"></i></div>
            <h1>Signing out</h1>
            <p>Revoking refresh token and clearing your HexShield session...</p>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthState.RevokeAndLogoutAsync();
        Navigation.NavigateTo("/login");
    }
}
