@page "/admin/courses/{CourseId:int}/enrollments"
@page "/teacher/courses/{CourseId:int}/enrollments"
@attribute [Authorize(Roles = "Admin,Teacher")]
@layout AdminLayout
@using System.Net.Http.Json
@using HexShield.Shared.DTOs
@using HexShield.Shared.Enums
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Enrollments &amp; Roster | HexShield</PageTitle>

<div class="enrollments-container">
    <div class="course-subnav">
        <a href="/@BasePortalSegment/courses" class="back-link">← All Courses</a>
        <div class="subnav-tabs">
            <a href="/@BasePortalSegment/courses/@CourseId/lessons" class="subnav-tab"><i class="fa-solid fa-chalkboard"></i> Lessons</a>
            <a href="/@BasePortalSegment/courses/@CourseId/assignments" class="subnav-tab"><i class="fa-solid fa-clipboard"></i> Assignments</a>
            <a href="/@BasePortalSegment/courses/@CourseId/quizzes" class="subnav-tab"><i class="fa-solid fa-stopwatch"></i> Quizzes</a>
            <a href="/@BasePortalSegment/courses/@CourseId/enrollments" class="subnav-tab active"><i class="fa-solid fa-users"></i> Enrollments</a>
            <a href="/@BasePortalSegment/courses/@CourseId/attendance" class="subnav-tab"><i class="fa-solid fa-chart-bar"></i> Attendance &amp; Progress</a>
        </div>
    </div>

    <div class="page-header">
        <div>
            <h1 class="page-title">Course #@CourseId — Student Roster &amp; Access</h1>
            <p class="page-subtitle">Manage student enrollments, active status flags, and course access.</p>
        </div>
        <button type="button" class="btn-primary" @onclick="() => isEnrollModalOpen = true">
            <i class="fa-solid fa-user-plus"></i> Enroll Student
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success")">
            <span>@statusMessage</span>
            <button type="button" class="alert-close" @onclick="() => statusMessage = null">&times;</button>
        </div>
    }

    <div class="table-card">
        @if (isLoading)
        {
            <div class="loading-state">
                <i class="fa-solid fa-spinner fa-spin spinner"></i>
                <p>Loading student roster...</p>
            </div>
        }
        else if (!enrollments.Any())
        {
            <div class="empty-state">
                <h3>No students enrolled in this course yet</h3>
                <p>Click "Enroll Student" to add a student by their User ID, or let students self-enroll from the Student Portal.</p>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Student Name</th>
                            <th>Email</th>
                            <th>Student User ID</th>
                            <th>Enrolled Date</th>
                            <th>Enrollment Status</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in enrollments)
                        {
                            <tr>
                                <td><strong>@item.StudentName</strong></td>
                                <td>@item.StudentEmail</td>
                                <td class="font-mono"><small>@item.StudentId</small></td>
                                <td>@item.EnrolledAt.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <select class="status-select status-@item.Status.ToString().ToLower()"
                                            value="@item.Status"
                                            @onchange="(e) => ChangeStatus(item.Id, e.Value?.ToString())">
                                        <option value="@EnrollmentStatus.Active">Active</option>
                                        <option value="@EnrollmentStatus.Completed">Completed</option>
                                        <option value="@EnrollmentStatus.Dropped">Dropped</option>
                                        <option value="@EnrollmentStatus.Suspended">Suspended</option>
                                    </select>
                                </td>
                                <td class="text-right">
                                    <button type="button" class="btn-icon btn-danger-icon" title="Unenroll" @onclick="() => Unenroll(item.Id)">
                                        Unenroll
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (isEnrollModalOpen)
{
    <div class="modal-overlay" @onclick="() => isEnrollModalOpen = false">
        <div class="modal-card" @onclick:stopPropagation="true">
            <h3>Enroll Student in Course #@CourseId</h3>
            <div class="form-group">
                <label>Student User ID (GUID or Profile ID) *</label>
                <input type="text" class="form-control" @bind="newStudentId" placeholder="Enter student User ID..." />
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-secondary" @onclick="() => isEnrollModalOpen = false">Cancel</button>
                <button type="button" class="btn-primary" @onclick="SubmitEnrollment">Enroll Student</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int CourseId { get; set; }
    private List<EnrollmentListDto> enrollments = new();
    private bool isLoading = true;
    private bool isEnrollModalOpen = false;
    private string newStudentId = string.Empty;
    private string? statusMessage;
    private bool isError;

    private string BasePortalSegment =>
        Navigation.Uri.Contains("/teacher", StringComparison.OrdinalIgnoreCase) ? "teacher" : "admin";

    protected override async Task OnInitializedAsync()
    {
        await LoadEnrollments();
    }

    private async Task LoadEnrollments()
    {
        isLoading = true;
        try
        {
            enrollments = await Http.GetFromJsonAsync<List<EnrollmentListDto>>($"api/enrollments/course/{CourseId}") ?? new();
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SubmitEnrollment()
    {
        if (string.IsNullOrWhiteSpace(newStudentId)) return;
        try
        {
            var response = await Http.PostAsJsonAsync("api/enrollments", new CreateEnrollmentRequestDto(CourseId, newStudentId.Trim()));
            if (response.IsSuccessStatusCode)
            {
                isEnrollModalOpen = false;
                newStudentId = string.Empty;
                statusMessage = "Student enrolled successfully.";
                isError = false;
                await LoadEnrollments();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                statusMessage = $"Failed to enroll: {body}";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isError = true;
        }
    }

    private async Task ChangeStatus(int enrollmentId, string? statusValue)
    {
        if (string.IsNullOrWhiteSpace(statusValue) || !Enum.TryParse<EnrollmentStatus>(statusValue, out var newStatus))
            return;

        try
        {
            var response = await Http.PatchAsJsonAsync($"api/enrollments/{enrollmentId}/status", new UpdateEnrollmentStatusDto(newStatus));
            if (response.IsSuccessStatusCode)
            {
                statusMessage = $"Enrollment status updated to {newStatus}.";
                isError = false;
                await LoadEnrollments();
            }
            else
            {
                statusMessage = "Failed to update status.";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isError = true;
        }
    }

    private async Task Unenroll(int id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/enrollments/{id}");
            if (response.IsSuccessStatusCode)
            {
                statusMessage = "Student unenrolled.";
                isError = false;
                await LoadEnrollments();
            }
            else
            {
                statusMessage = "Failed to unenroll student.";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isError = true;
        }
    }
}
