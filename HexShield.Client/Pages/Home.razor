@page "/"

@layout PublicLayout

<PageTitle>HexShield | Intelligent LMS</PageTitle>

<section class="hero-section">

    <div class="hero-content">

        <div class="hero-badge">
            ● ENTERPRISE LEARNING PLATFORM
        </div>

        <h1>
            The Intelligent LMS built for
            <span>modern academies.</span>
        </h1>

        <p>
            HexShield combines structured learning,
            secure identity, organization-aware access
            and intelligent educational delivery in one platform.
        </p>

        <div class="hero-actions">

            <a href="/register"
               class="hero-primary">
                Get Started
            </a>

            <a href="/login"
               class="hero-secondary">
                Sign In
            </a>

        </div>

    </div>

    <div class="hero-panel">

        <div class="panel-top">
            <span>HEXSHIELD LMS</span>
            <span class="online">● SYSTEM ONLINE</span>
        </div>

        <div class="panel-stat">

            <strong>Secure learning infrastructure</strong>

            <span>
                RBAC · Multi-Tenancy · JWT · SQL Server
            </span>

        </div>

        <div class="panel-grid">

            <div>
                <strong>Admin</strong>
                <span>Governance</span>
            </div>

            <div>
                <strong>Teacher</strong>
                <span>Instruction</span>
            </div>

            <div>
                <strong>Student</strong>
                <span>Learning</span>
            </div>

        </div>

    </div>

</section>

<section class="architecture-section"
         id="architecture">

    <div class="section-heading">

        <span>PLATFORM ARCHITECTURE</span>

        <h2>
            Built around secure educational delivery.
        </h2>

        <p>
            Every part of HexShield is designed around
            controlled access and organization-aware data.
        </p>

    </div>

    <div class="feature-grid">

        <div class="feature-card">

            <span>01</span>

            <h3>Role-Based Access</h3>

            <p>
                Admin, Teacher and Student access is
                enforced through server-side authorization.
            </p>

        </div>

        <div class="feature-card">

            <span>02</span>

            <h3>Multi-Tenant Security</h3>

            <p>
                Tenant boundaries prevent users from
                accessing another organization's data.
            </p>

        </div>

        <div class="feature-card">

            <span>03</span>

            <h3>Secure Identity</h3>

            <p>
                JWT access tokens, refresh-token rotation,
                account lockout and protected APIs.
            </p>

        </div>

    </div>

</section>

<section class="curriculum-section"
         id="curriculum">

    <div>

        <span>LEARNING PLATFORM</span>

        <h2>
            Learning infrastructure designed
            for scale.
        </h2>

        <p>
            Courses, lessons, assignments, quizzes and
            progress tracking will be built on the
            security foundation already established.
        </p>

        <a href="/register"
           class="hero-primary">
            Enter HexShield
        </a>

    </div>

</section>