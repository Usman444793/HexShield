@page "/register"
@layout PublicLayout
@attribute [AllowAnonymous]
@using System.Net.Http.Json
@using HexShield.Client.Services
@using HexShield.Shared.DTOs
@using HexShield.Shared.Enums
@inject HttpClient Http
@inject CustomAuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<PageTitle>Create Account | HexShield</PageTitle>

<div class="auth-page">
    <div class="auth-card register-card">
        <div class="auth-header">
            <div class="auth-logo"><i class="fa-solid fa-hexagon-nodes"></i></div>
            <h1>Create your account</h1>
            <p>Start learning with HexShield.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="auth-error">
                @errorMessage
            </div>
        }

        <EditForm Model="@registerRequest" OnValidSubmit="RegisterAsync">
            <DataAnnotationsValidator />
            <div class="form-row">
                <div class="form-group">
                    <label>First name</label>
                    <InputText @bind-Value="registerRequest.FirstName" class="form-control" placeholder="John" />
                    <ValidationMessage For="@(() => registerRequest.FirstName)" />
                </div>
                <div class="form-group">
                    <label>Last name</label>
                    <InputText @bind-Value="registerRequest.LastName" class="form-control" placeholder="Doe" />
                    <ValidationMessage For="@(() => registerRequest.LastName)" />
                </div>
            </div>
            <div class="form-group">
                <label>Email</label>
                <InputText @bind-Value="registerRequest.Email" class="form-control" type="email" placeholder="john.doe@example.com" />
                <ValidationMessage For="@(() => registerRequest.Email)" />
            </div>
            <div class="form-group">
                <label>Password</label>
                <InputText @bind-Value="registerRequest.Password"
                           class="form-control"
                           type="password"
                           placeholder="••••••••••••" />
                <ValidationMessage For="@(() => registerRequest.Password)" />
                <small class="text-muted">
                    Minimum 12 characters with uppercase, lowercase, digit, and special character.
                </small>
            </div>
            <div class="form-group">
                <label>Department</label>
                <InputText @bind-Value="registerRequest.Department"
                           class="form-control"
                           placeholder="Computer Science" />
            </div>
            <button type="submit" class="auth-submit" disabled="@isLoading">
                @(isLoading ? "Creating account..." : "Create Account")
            </button>
        </EditForm>

        <div class="auth-footer">
            Already have an account?
            <a href="/login">Sign in</a>
        </div>
    </div>
</div>

@code {
    private RegisterRequestDto registerRequest = new();
    private bool isLoading;
    private string? errorMessage;

    private async Task RegisterAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/register", registerRequest);
            var responseBody = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(responseBody);
                    if (doc.RootElement.TryGetProperty("errors", out var errorsProp) && errorsProp.ValueKind == System.Text.Json.JsonValueKind.Object)
                    {
                        var errList = new List<string>();
                        foreach (var prop in errorsProp.EnumerateObject())
                        {
                            if (prop.Value.ValueKind == System.Text.Json.JsonValueKind.Array)
                            {
                                foreach (var err in prop.Value.EnumerateArray())
                                {
                                    var val = err.GetString();
                                    if (!string.IsNullOrWhiteSpace(val)) errList.Add(val);
                                }
                            }
                            else
                            {
                                var val = prop.Value.GetString();
                                if (!string.IsNullOrWhiteSpace(val)) errList.Add(val);
                            }
                        }
                        errorMessage = errList.Count > 0 ? string.Join(" ", errList) : "Validation failed.";
                    }
                    else if (doc.RootElement.TryGetProperty("detail", out var detailProp))
                    {
                        errorMessage = detailProp.GetString();
                    }
                    else if (doc.RootElement.TryGetProperty("message", out var msgProp))
                    {
                        errorMessage = msgProp.GetString();
                    }
                    else if (doc.RootElement.TryGetProperty("title", out var titleProp))
                    {
                        errorMessage = titleProp.GetString();
                    }
                    else
                    {
                        errorMessage = "Registration failed. Please check your information.";
                    }
                }
                catch
                {
                    errorMessage = string.IsNullOrWhiteSpace(responseBody)
                        ? "Registration failed. Please check your information."
                        : responseBody;
                }
                return;
            }

            var result = System.Text.Json.JsonSerializer.Deserialize<AuthResponseDto>(responseBody,
                new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

            if (result == null || string.IsNullOrWhiteSpace(result.AccessToken))
            {
                errorMessage = "Registration succeeded but authentication response was empty.";
                return;
            }

            await AuthState.MarkUserAsAuthenticated(result.AccessToken, result.RefreshToken);

            var roles = result.Roles ?? Enumerable.Empty<string>();
            if (roles.Any(r => string.Equals(r, LmsRoles.Admin, StringComparison.OrdinalIgnoreCase)))
            {
                Navigation.NavigateTo("/admin");
            }
            else if (roles.Any(r => string.Equals(r, LmsRoles.Teacher, StringComparison.OrdinalIgnoreCase)))
            {
                Navigation.NavigateTo("/teacher");
            }
            else
            {
                Navigation.NavigateTo("/student");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to connect to registration service: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
