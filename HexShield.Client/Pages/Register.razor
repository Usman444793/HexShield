@page "/register"
@layout PublicLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Components.WebAssembly.Http
@using HexShield.Client.Services
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Create Account | HexShield</PageTitle>

<div class="auth-page">
    <div class="auth-card register-card">
        <div class="auth-header">
            <div class="auth-logo">H</div>
            <h1>Create your account</h1>
            <p>Start learning with HexShield.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="auth-error">
                @errorMessage
            </div>
        }
        <EditForm Model="@registerRequest" OnValidSubmit="RegisterAsync" Enhance="false">
            <DataAnnotationsValidator />
            <div class="form-row">
                <div class="form-group">
                    <label>First name</label>
                    <InputText @bind-Value="registerRequest.FirstName" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Last name</label>
                    <InputText @bind-Value="registerRequest.LastName" class="form-control" />
                </div>
            </div>
            <div class="form-group">
                <label>Email</label>
                <InputText @bind-Value="registerRequest.Email" class="form-control" type="email" />
            </div>
            <div class="form-group">
                <label>Password</label>
                <InputText @bind-Value="registerRequest.Password"
                           class="form-control"
                           type="password" />
                <small>
                    Minimum 12 characters with uppercase,
                    lowercase, digit and special character.
                </small>
            </div>
            <div class="form-group">
                <label>Department</label>
                <InputText @bind-Value="registerRequest.Department"
                           class="form-control" />
            </div>
            <button type="submit" class="auth-submit" disabled="@isLoading">
                @(isLoading ? "Creating account..." : "Create Account")
            </button>
        </EditForm>

        <div class="auth-footer">
            Already have an account?
            <a href="/login">Sign in</a>
        </div>
    </div>
</div>

@code {
    private RegisterRequestDto registerRequest = new();
    private bool isLoading;
    private string? errorMessage;

    private async Task RegisterAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var request = new HttpRequestMessage(HttpMethod.Post, "api/auth/register")
            {
                Content = JsonContent.Create(registerRequest)
            };
            request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
            request.Headers.Add("X-Requested-With", "XMLHttpRequest");

            var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Registration failed. Please check your information.";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<AuthResponseDto>();
            if (result == null || string.IsNullOrWhiteSpace(result.AccessToken))
            {
                errorMessage = "Registration succeeded but authentication failed.";
                return;
            }

            // Use client-side provider if available
            var mark = AuthStateProvider?.GetType().GetMethod("MarkUserAsAuthenticated");
            if (mark != null)
            {
                var task = mark.Invoke(AuthStateProvider, new object[] { result.AccessToken });
                if (task is Task t) await t;
            }

            var roles = result.Roles ?? Enumerable.Empty<string>();
            if (roles.Any(r => string.Equals(r, "Admin", StringComparison.OrdinalIgnoreCase)))
            {
                Navigation.NavigateTo("/admin");
            }
            else if (roles.Any(r => string.Equals(r, "Teacher", StringComparison.OrdinalIgnoreCase)))
            {
                Navigation.NavigateTo("/teacher");
            }
            else
            {
                Navigation.NavigateTo("/student");
            }
        }
        catch (Exception)
        {
            errorMessage = "Unable to connect to the registration service.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
