@page "/admin/users"
@rendermode InteractiveAuto
@using HexShield.Models.DTOs.Admin
@using Microsoft.AspNetCore.Authorization
@*attribute [Authorize(Policy = "AdminOnly")]*@
@inject HttpClient Http

<PageTitle>Manage Users</PageTitle>

<div class="container mt-4">
    <h1>System Users</h1>
    <p>Welcome, Administrator. Here is the list of registered users.</p>

    @if (users == null)
    {
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    }
    else if (!users.Any())
    {
        <div class="alert alert-info">No users found in this organization.</div>
    }
    else
    {
        <table class="table table-striped table-hover mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Tenant ID</th>
                    <th>Status</th>
                    <th>Created At</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in users)
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@user.TenantId</td>
                        <td>
                            <span class="badge @(user.IsActive ? "bg-success" : "bg-danger")">
                                @(user.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<UserDto>? users;

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            // This calls the API we already built!
            users = await Http.GetFromJsonAsync<List<UserDto>>("api/AdminUser");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading users: {ex.Message}");
        }
    }

    // Simple DTO for the table
    public class UserDto {
        public string Id { get; set; } = "";
        public string Email { get; set; } = "";
        public string FullName { get; set; } = "";
        public bool IsActive { get; set; }
        public int TenantId { get; set; }
        public DateTimeOffset CreatedAt { get; set; }
    }
}