@page "/admin/users"
@layout AdminLayout
@attribute [Authorize(Policy = "AdminOnly")]
@using HexShield.Shared.DTOs
@using HexShield.Shared.Enums
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>User Management | HexShield Admin</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="text-muted small mb-1">
                <a href="/admin" class="text-decoration-none text-muted"><i class="fa-solid fa-arrow-left"></i> Dashboard</a>
            </div>
            <h2 class="fw-bold mb-1">User Directory</h2>
            <p class="text-muted mb-0">Provision user accounts, govern lifecycle states, and oversee assigned tenant roles.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" @onclick="LoadUsersAsync">
                <i class="fa-solid fa-arrows-rotate me-1"></i> Refresh
            </button>
            <button class="btn btn-primary" style="background: #0b3948; border-color: #0b3948;" @onclick="OpenCreateUserModal">
                <i class="fa-solid fa-user-plus me-1"></i> Create User
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            <span>@statusMessage</span>
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <div class="input-group" style="max-width: 320px;">
                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" class="form-control bg-light border-start-0" placeholder="Search by name or email..." @bind="searchTerm" @bind:event="oninput" />
            </div>
            <div class="text-muted small">Showing @(FilteredUsers.Count) user(s)</div>
        </div>
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="p-5 text-center text-muted">
                    <i class="fa-solid fa-spinner fa-spin fa-2x mb-3"></i>
                    <p class="mb-0">Loading user records...</p>
                </div>
            }
            else if (!FilteredUsers.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="fa-solid fa-users-slash fa-2x mb-3"></i>
                    <p class="mb-0">No users found matching your search.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">User</th>
                                <th>Email</th>
                                <th>Tenant</th>
                                <th>Roles</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in FilteredUsers)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@user.FullName</div>
                                        <div class="text-muted small">ID: @user.Id</div>
                                    </td>
                                    <td>@user.Email</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">Tenant #@user.TenantId</span>
                                    </td>
                                    <td>
                                        @if (user.Roles != null && user.Roles.Any())
                                        {
                                            @foreach (var r in user.Roles)
                                            {
                                                <span class="badge @GetRoleBadgeClass(r) me-1">@r</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">None</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(user.IsActive ? "bg-success" : "bg-danger")">
                                            @(user.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="text-muted small">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-outline-primary me-1" title="Manage Roles" @onclick="() => OpenRolesModal(user)">
                                            <i class="fa-solid fa-user-shield"></i>
                                        </button>
                                        <button class="btn btn-sm @(user.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                title="@(user.IsActive ? "Deactivate User" : "Activate User")"
                                                @onclick="() => ToggleUserStatusAsync(user)">
                                            <i class="fa-solid @(user.IsActive ? "fa-user-slash" : "fa-user-check")"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@if (isCreateModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Provision New User</h5>
                    <button type="button" class="btn-close" @onclick="() => isCreateModalOpen = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col">
                            <label class="form-label fw-semibold">First Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="John" @bind="newUser.FirstName" />
                        </div>
                        <div class="col">
                            <label class="form-label fw-semibold">Last Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="Doe" @bind="newUser.LastName" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" placeholder="john.doe@company.com" @bind="newUser.Email" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Password <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" placeholder="••••••••••••" @bind="newUser.Password" />
                        <div class="form-text">Minimum 12 characters (uppercase, lowercase, digit, special char).</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Initial Role <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="newUser.SelectedRole">
                            <option value="Student">Student</option>
                            <option value="Teacher">Teacher</option>
                            <option value="Admin">Administrator</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" @onclick="() => isCreateModalOpen = false">Cancel</button>
                    <button type="button" class="btn btn-primary" style="background: #0b3948; border-color: #0b3948;" @onclick="CreateUserAsync" disabled="@isSaving">
                        @(isSaving ? "Creating..." : "Create User")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (isRolesModalOpen && selectedUser != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Manage Roles: @selectedUser.FullName</h5>
                    <button type="button" class="btn-close" @onclick="() => isRolesModalOpen = false"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">Assigned roles for <strong>@selectedUser.Email</strong>.</p>
                    <div class="list-group">
                        @foreach (var role in availableRoles)
                        {
                            var hasRole = selectedUser.Roles?.Contains(role, StringComparer.OrdinalIgnoreCase) == true;
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge @GetRoleBadgeClass(role) me-2">@role</span>
                                </div>
                                <div>
                                    @if (hasRole)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveRoleAsync(role)">
                                            <i class="fa-solid fa-trash me-1"></i> Remove
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => AssignRoleAsync(role)">
                                            <i class="fa-solid fa-plus me-1"></i> Assign
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => isRolesModalOpen = false">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<UserListDto> users = new();
    private string searchTerm = string.Empty;
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isCreateModalOpen = false;
    private bool isRolesModalOpen = false;
    private UserListDto? selectedUser;
    private string? statusMessage;
    private bool isError = false;

    private readonly string[] availableRoles = new[] { LmsRoles.Admin, LmsRoles.Teacher, LmsRoles.Student };

    private NewUserModel newUser = new();

    private class NewUserModel
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string SelectedRole { get; set; } = "Student";
    }

    private List<UserListDto> FilteredUsers => string.IsNullOrWhiteSpace(searchTerm)
        ? users
        : users.Where(u => u.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                           u.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        isLoading = true;
        try
        {
            users = await Http.GetFromJsonAsync<List<UserListDto>>("api/admin/users") ?? new();
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to load users: {ex.Message}";
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateUserModal()
    {
        newUser = new NewUserModel();
        isCreateModalOpen = true;
    }

    private async Task CreateUserAsync()
    {
        if (string.IsNullOrWhiteSpace(newUser.FirstName) ||
            string.IsNullOrWhiteSpace(newUser.LastName) ||
            string.IsNullOrWhiteSpace(newUser.Email) ||
            string.IsNullOrWhiteSpace(newUser.Password))
        {
            statusMessage = "All fields are required.";
            isError = true;
            return;
        }

        isSaving = true;
        statusMessage = null;

        try
        {
            var dto = new CreateUserRequestDto(
                newUser.FirstName.Trim(),
                newUser.LastName.Trim(),
                newUser.Email.Trim(),
                newUser.Password,
                new[] { newUser.SelectedRole }
            );

            var response = await Http.PostAsJsonAsync("api/admin/users", dto);
            if (response.IsSuccessStatusCode)
            {
                statusMessage = $"User '{newUser.Email}' created successfully.";
                isError = false;
                isCreateModalOpen = false;
                await LoadUsersAsync();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                statusMessage = $"Error creating user: {err}";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Service error: {ex.Message}";
            isError = true;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleUserStatusAsync(UserListDto user)
    {
        var action = user.IsActive ? "deactivate" : "activate";
        try
        {
            var response = await Http.PutAsync($"api/admin/users/{user.Id}/{action}", null);
            if (response.IsSuccessStatusCode)
            {
                statusMessage = $"User '{user.FullName}' has been {(user.IsActive ? "deactivated" : "activated")}.";
                isError = false;
                await LoadUsersAsync();
            }
            else
            {
                statusMessage = $"Failed to {action} user.";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isError = true;
        }
    }

    private void OpenRolesModal(UserListDto user)
    {
        selectedUser = user;
        isRolesModalOpen = true;
    }

    private async Task AssignRoleAsync(string roleName)
    {
        if (selectedUser == null) return;
        try
        {
            var dto = new AssignRoleDto(roleName);
            var response = await Http.PostAsJsonAsync($"api/admin/users/{selectedUser.Id}/roles", dto);
            if (response.IsSuccessStatusCode)
            {
                statusMessage = $"Role '{roleName}' assigned.";
                isError = false;
                await LoadUsersAsync();
                selectedUser = users.FirstOrDefault(u => u.Id == selectedUser.Id);
            }
            else
            {
                statusMessage = "Failed to assign role.";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isError = true;
        }
    }

    private async Task RemoveRoleAsync(string roleName)
    {
        if (selectedUser == null) return;
        try
        {
            var response = await Http.DeleteAsync($"api/admin/users/{selectedUser.Id}/roles/{roleName}");
            if (response.IsSuccessStatusCode)
            {
                statusMessage = $"Role '{roleName}' removed.";
                isError = false;
                await LoadUsersAsync();
                selectedUser = users.FirstOrDefault(u => u.Id == selectedUser.Id);
            }
            else
            {
                statusMessage = "Failed to remove role.";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isError = true;
        }
    }

    private string GetRoleBadgeClass(string role) => role switch
    {
        "Admin" => "bg-danger",
        "Teacher" => "bg-primary",
        "Student" => "bg-success",
        _ => "bg-secondary"
    };
}