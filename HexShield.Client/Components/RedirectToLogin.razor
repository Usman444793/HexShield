@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Ensure provider has initialized (WASM provider exposes InitializeFromStorageAsync)
        var init = AuthStateProvider?.GetType().GetMethod("InitializeFromStorageAsync");
        if (init != null)
        {
            var r = init.Invoke(AuthStateProvider, null);
            if (r is Task t) await t;
        }

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            return;
        }

        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        var loginUrl = string.IsNullOrWhiteSpace(returnUrl)
            ? "/login"
            : $"/login?returnUrl={Uri.EscapeDataString("/" + returnUrl)}";

        Navigation.NavigateTo(loginUrl);
    }
}
